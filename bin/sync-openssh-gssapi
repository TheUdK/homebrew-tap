#!/usr/bin/env python3
"""Re-point Formula/openssh-gssapi.rb at homebrew/core's current openssh,
together with the matching Debian gssapi.patch.

Refuses to bump unless Debian's src:openssh-gssapi has published a release
tag for that exact OpenSSH version -- the gsskex patch touches kex/monitor
internals and will not apply across an OpenSSH bump, so bumping the tarball
alone would only produce a formula that cannot build.
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import urllib.parse
import urllib.request
from pathlib import Path

PROJECT = "ssh-team%2Fopenssh-gssapi"
FORMULA = Path(__file__).resolve().parent.parent / "Formula" / "openssh-gssapi.rb"


def get(url):
    with urllib.request.urlopen(url, timeout=60) as r:
        return r.read()


def core_openssh():
    out = subprocess.run(
        ["brew", "info", "--json=v2", "openssh"],
        capture_output=True, text=True, check=True,
    ).stdout
    f = json.loads(out)["formulae"][0]
    s = f["urls"]["stable"]
    return f["versions"]["stable"], s["url"], s["checksum"]


def debian_tag(version):
    """Newest debian/1%<version>-<rev> tag, or None."""
    tags = json.loads(get(
        f"https://salsa.debian.org/api/v4/projects/{PROJECT}"
        f"/repository/tags?per_page=100"
    ))
    pat = re.compile(rf"^debian/1%{re.escape(version)}-(.+)$")
    matches = [t for t in tags if pat.match(t["name"])]
    if not matches:
        return None
    matches.sort(key=lambda t: t["commit"]["created_at"])
    return matches[-1]["name"]


def sub_once(text, pattern, replacement, what):
    """Substitute exactly one occurrence, or abort.

    Guards against `brew style --fix` reordering blocks and a loose regex
    silently rewriting the wrong stanza.
    """
    new, n = re.subn(pattern, replacement, text, count=1, flags=re.M)
    if n != 1:
        sys.exit(f"error: could not locate {what} in {FORMULA.name}; refusing to write")
    return new


def main():
    text = original = FORMULA.read_text()
    m = re.search(r'^  version "(.+)"$', text, re.M)
    if not m:
        sys.exit(f"error: no version stanza in {FORMULA.name}")
    current = m.group(1)

    version, url, checksum = core_openssh()
    if version == current:
        print(f"already in sync with homebrew/core openssh {version}")
        return 0

    tag = debian_tag(version)
    if tag is None:
        print(
            f"::warning::homebrew/core is on openssh {version} but Debian "
            f"src:openssh-gssapi has no release tag for it yet; not bumping. "
            f"Staying on {current}."
        )
        return 0

    patch_url = (
        "https://salsa.debian.org/ssh-team/openssh-gssapi/-/raw/"
        f"{urllib.parse.quote(tag, safe='/')}/debian/patches/gssapi.patch"
    )
    patch_sha = hashlib.sha256(get(patch_url)).hexdigest()
    mirror = url.replace("https://cdn.openbsd.org/",
                         "https://cloudflare.cdn.openbsd.org/")

    text = sub_once(text, r'^  url ".+"$', f'  url "{url}"', "url")
    text = sub_once(text, r'^  mirror ".+"$', f'  mirror "{mirror}"', "mirror")
    text = sub_once(text, r'^  version ".+"$', f'  version "{version}"', "version")
    text = sub_once(text, r'^  sha256 ".+"$', f'  sha256 "{checksum}"', "tarball sha256")

    # Rewrite url+sha256 together, scoped to the patch block, so a reordered
    # formula can never point this at some other resource's checksum.
    text = sub_once(
        text,
        r'(  patch do\n    url ")[^"]+("\n    sha256 ")[0-9a-f]{64}(")',
        lambda _m: f"{_m.group(1)}{patch_url}{_m.group(2)}{patch_sha}{_m.group(3)}",
        "patch block",
    )

    if text == original:
        sys.exit("error: nothing changed; refusing to commit a no-op")

    FORMULA.write_text(text)
    print(f"bumped {current} -> {version} (patch from {tag})")
    if out := os.environ.get("GITHUB_OUTPUT"):
        with open(out, "a") as fh:
            fh.write(f"version={version}\n")
            fh.write(f"previous={current}\n")
            fh.write(f"debian_tag={tag}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
